{
  "name": "get_dimension_breakdown",
  "description": "Compare a requested KPI between the latest two complete weeks across a supported business dimension. Use this tool to identify where a KPI change is concentrated and to drill down from channel level to campaign level.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "metric": {
        "type": "string",
        "enum": [
          "revenue",
          "spend",
          "profit",
          "clicks",
          "conversions",
          "roas",
          "ctr",
          "cvr",
          "cpa"
        ]
      },
      "dimension": {
        "type": "string",
        "enum": [
          "channel",
          "campaign"
        ]
      },
      "filters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "channel": {
            "type": "string"
          }
        }
      }
    },
    "required": [
      "metric",
      "dimension"
    ]
  }
}
