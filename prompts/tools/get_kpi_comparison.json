{
  "name": "get_kpi_comparison",
  "description": "Compare a requested KPI between two periods, optionally filtered by business dimensions, and return the current value, previous value, absolute change, and percentage change.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "metric": {
        "type": "string",
        "enum": [
          "revenue",
          "spend",
          "profit",
          "roas",
          "clicks",
          "conversions",
          "cpa",
          "cvr"
        ]
      },
      "current_period": {
        "type": "string"
      },
      "comparison_period": {
        "type": "string"
      },
      "filters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "channel": {
            "type": "string"
          },
          "campaign": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "product": {
            "type": "string"
          }
        }
      }
    },
    "required": [
      "metric",
      "current_period",
      "comparison_period"
    ]
  }
}
