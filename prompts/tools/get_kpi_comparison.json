{
  "name": "get_kpi_comparison",
  "description": "Compare a requested KPI between the latest two complete weeks, optionally filtered to a specific channel, and return the current value, previous value, absolute change, and percentage change.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "metric": {
        "type": "string",
        "enum": [
          "revenue",
          "spend",
          "profit",
          "clicks",
          "conversions",
          "roas",
          "ctr",
          "cvr",
          "cpa"
        ]
      },
      "filters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "channel": {
            "type": "string"
          }
        }
      }
    },
    "required": [
      "metric"
    ]
  }
}
